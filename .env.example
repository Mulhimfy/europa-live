# Europa Live — configuration (all optional; defaults shown)
PORT=8080
HOST=0.0.0.0
# WEB_CONCURRENCY=auto        # worker processes: 0 (single), N, or "auto" (one per CPU)
# TRUST_PROXY=true            # honour X-Forwarded-For behind a load balancer
# PUBLIC_URL=https://live.example.com   # enables HSTS when https
# LOG_LEVEL=info

# Limits
# RATE_LIMIT_MAX=240          # API requests per minute per IP
# RATE_LIMIT_IMG_MAX=600      # image proxy requests per minute per IP
# UPSTREAM_TIMEOUT_MS=9000
# LIVE_DEADLINE_MS=30000
# CACHE_MAX_ENTRIES=5000
# CACHE_SNAP_METRES=150       # clicks closer than this share a cache entry
# IMG_PROXY_MAX_BYTES=8388608
# IMG_PROXY_EXTRA_HOSTS=      # extra hostnames allowed through /img (comma separated)

# Optional provider keys — every feature degrades gracefully without them
# WINDY_WEBCAMS_KEY=          # https://api.windy.com/webcams  (tens of thousands of webcams with live players)
# YOUTUBE_API_KEY=            # YouTube Data API v3 (live streams near the place)
# MAPILLARY_TOKEN=            # https://www.mapillary.com/developer (recent street-level imagery)
# NASA_FIRMS_KEY=             # https://firms.modaps.eosdis.nasa.gov/api/ (24 h fire hotspot list)
# AISSTREAM_KEY=              # https://aisstream.io (live vessels via AIS websocket)
# TRAFIKVERKET_KEY=           # https://data.trafikverket.se (Swedish road cameras)
# OPENSKY_USER= / OPENSKY_PASS=  # OpenSky Network account (extra ADS-B source)
